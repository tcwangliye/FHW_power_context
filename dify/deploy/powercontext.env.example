# PowerContext settings for running the Server on the host (development mode).
# The container deployment in docker-compose.lethe.yaml sets these itself.
#
# Copy to a local, uncommitted file and load it with:
#   powercontext server run --env-file <path>

POWERCONTEXT_HOME=/absolute/path/to/powercontext-data
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8000
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_LOGGING_LEVEL=INFO

# SQLite is the default backend and needs no extra configuration.
# Keep POWERCONTEXT_SERVER_DATABASE_URL unset to use the user data directory.
#
# Generation and embedding models are optional for this application: the tavern
# stores explicit memories and recalls them lexically, so no inference provider
# is required. Configure one only if you want automatic extraction as well.
