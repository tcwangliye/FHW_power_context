# Append these lines to <dify-checkout>/docker/.env BEFORE the first start.
#
# Dify routes HTTP Request nodes, tool calls and model-provider calls through
# its ssrf_proxy (squid), which denies private destinations by default. The
# tavern bridge lives on the compose network, so that range must be allowlisted
# or every HTTP Request node fails with "blocked by SSRF protection".
#
# The subnet matches deploy/docker-compose.lethe.yaml (LETHE_DOCKER_SUBNET).
SSRF_PROXY_ALLOW_PRIVATE_IPS=172.28.0.0/16

# Only needed when the model endpoint itself is a private address, for example
# Ollama on the Docker host or a LAN gateway. Widen the list instead of
# replacing it:
# SSRF_PROXY_ALLOW_PRIVATE_IPS=172.28.0.0/16,192.168.0.0/16,10.0.0.0/8
